# Copia este archivo como ".env" y ajusta los valores a tu entorno
# En producción IIS usa las variables de entorno del application pool

# ── Conexión SQL Server ───────────────────────────────────────────────────
DB_SERVER=localhost          # nombre del servidor o IP (ej: MSERVER\MINEDAX)
DB_NAME=MineDax
DB_USER=sa
DB_PASSWORD=contraseña

# ── Puerto del servidor Node ───────────────────────────────────────────────
PORT=3000

# ── SMTP (Nodemailer) para envío de correos ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nomina.collectivemining@gmail.com
SMTP_PASS=app-password-aqui
SMTP_FROM=nomina.collectivemining@gmail.com
