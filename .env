# Copia este archivo como ".env" y ajusta los valores a tu entorno
# En producción IIS usa las variables de entorno del application pool

# ── Conexión SQL Server ───────────────────────────────────────────────────
DB_SERVER=DESKTOP-VEABB8R\SQLEXPRESS          # nombre del servidor o IP (ej: MSERVER\MINEDAX)
DB_NAME=MineDax
DB_USER=sa
DB_PASSWORD=LetItHappen35*

# ── Puerto del servidor Node ───────────────────────────────────────────────
PORT=3000

# ── Identificadores de la empresa ────────────────────────────────────────────
# COD_EMPR: código smallint que identifica la empresa en MineDax (ajustar al valor correcto)
COD_EMPR=1
# APP_USER: usuario de 8 chars que queda en las columnas ACT_USUA (auditoría)
APP_USER=SARLAFT

# ── Tipo de tercero para personas jurídicas ───────────────────────────────────
# TIP_TERC_JURID: valor que acepta la constraint GNC03TERCE en GN_TERCE.TIP_TERC
# Al iniciar el servidor se loguea la definición real de la constraint.
# Si el INSERT falla con "conflicted with CHECK constraint GNC03TERCE",
# consultar GET /api/debug/tip-terc y ajustar este valor.
TIP_TERC_JURID=E
