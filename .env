# Copia este archivo como ".env" y ajusta los valores a tu entorno
# En producción IIS usa las variables de entorno del application pool

# ── Conexión SQL Server ───────────────────────────────────────────────────
DB_SERVER=CM-ITD-P-05\SQLEXPRESS          # nombre del servidor o IP (ej: MSERVER\MINEDAX)
DB_NAME=MineDax
DB_USER=sa
DB_PASSWORD=LetItHappen35*

# ── Puerto del servidor Node ───────────────────────────────────────────────
PORT=3000

# ── Identificadores de la empresa ────────────────────────────────────────────
# COD_EMPR: código smallint que identifica la empresa en MineDax (ajustar al valor correcto)
COD_EMPR=1
# APP_USER: usuario de 8 chars que queda en las columnas ACT_USUA (auditoría)
APP_USER=SARLAFT

ADMIN_USUARIO=nombre_admin
ADMIN_CLAVE=contraseña_segura
SESSION_SECRET=cadena_aleatoria_de_64_chars

# ── URL pública de la aplicación (para links en correos) ─────────────────────
APP_URL=http://localhost:3000

# ── Correo del administrador general (recibe solicitudes de aprobación) ───────
SUPER_ADMIN_EMAIL=admin@minedax.com

# ── SMTP para envío de correos ────────────────────────────────────────────────
# Dejar vacío SMTP_HOST para que los correos se registren solo en consola (modo dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@minedax.com
